{
  "expo": {
    "name": "Hisaab",
    "slug": "hisaab",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hisaab",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.manahil.hisaab",
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.manahil.hisaab",
      "versionCode": 4,
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#0E7C5A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.READ_SMS",
        "android.permission.RECEIVE_SMS",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E7C5A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0E7C5A"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Hisaab to use Face ID to unlock the app."
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Hisaab to attach receipt photos to your transactions.",
          "cameraPermission": "Allow Hisaab to take receipt photos for your transactions.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      [
        "expo-localization",
        {
          "supportsRTL": false
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3873864995862689~3972002502",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "delayAppMeasurementInit": true
        }
      ],
      "./plugins/with-proguard-rules.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "manahil_fatima72",
    "extra": {
      "eas": {
        "projectId": "b34fffed-462d-4af0-bf74-0e9aef9c767f"
      }
    }
  }
}
